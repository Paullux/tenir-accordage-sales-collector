# ---------------------------------------------------------------------------
# tenir-accordage-sales-collector configuration
# Copy this file to .env and fill in the values. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Book identification (all filters are OR-combined: a transaction matches
# if it matches the ISBN when provided, otherwise falls back to the title) ---
BOOK_TITLE=Tenir l'accordage
BOOK_ISBN=

# --- Currency ---
# All figures returned by /v1/stats are converted to this currency.
TARGET_CURRENCY=EUR

# Static conversion rates applied when a platform reports a transaction in a
# currency other than TARGET_CURRENCY (JSON object of "CODE": rate-to-target).
# There is no live FX lookup (this service is meant to run fully offline and
# read-only) so update this periodically. Missing currencies fall back to 1.0
# and log a warning.
FX_RATES_TO_EUR={"USD": 0.92, "GBP": 1.17, "CAD": 0.68, "AUD": 0.60, "JPY": 0.0062}

# --- Security ---
# Long random secret used as a Bearer token to protect every route except
# /health. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
COLLECTOR_API_TOKEN=

# --- Scheduling ---
SYNC_INTERVAL_MINUTES=360
# A call to /v1/stats older than this many minutes since the last sync also
# triggers a background sync (the response itself is still served from cache).
STALE_AFTER_MINUTES=60

# --- Optional browser automation (Playwright), one flag per platform.
# Disabled by default: import mode (dropping report files in /data/imports/<platform>/)
# is fully functional on its own. See README for the manual bootstrap procedure.
AMAZON_BROWSER_SYNC=false
KOBO_BROWSER_SYNC=false
GOOGLE_BROWSER_SYNC=false

# --- Storage ---
DATA_DIR=/data

# --- HTTP server ---
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
